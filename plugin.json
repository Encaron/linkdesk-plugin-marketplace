{
  "$schema": "./node_modules/@linkdesk/plugin-sdk/schemas/plugin.schema.json",
  "pluginId": "marketplace",
  "name": "插件市场",
  "version": "1.4.40",
  "category": "productivity",
  "minAppVersion": "0.2.63",
  "icon": "resources/icon.svg",
  "marketIcon": "resources/icon-brand.svg",
  "description": "浏览、安装和管理插件",
  "author": "Encaron",
  "distribution": "builtin",
  "factoryRole": "marketplace",
  "entry": "src/index.tsx",
  "appearsIn": {
    "iconBar": "top",
    "sidePanel": true
  },
  "contributes": {
    "commands": [
      {
        "id": "marketplace.addSource",
        "risk": "R2",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when the source was written"
          },
          {
            "name": "added",
            "type": "string",
            "optional": true,
            "description": "Normalized source URL"
          },
          {
            "name": "noop",
            "type": "boolean",
            "optional": true,
            "description": "Present when nothing changed"
          },
          {
            "name": "reason",
            "type": "string",
            "optional": true,
            "description": "official | duplicate | empty | bad-url"
          }
        ],
        "example": {
          "url": "https://github.com/encaron/linkdesk-marketplace"
        },
        "title": "添加市场源",
        "category": "插件市场",
        "description": "添加一个作者市场源（该仓库根目录需有 marketplace.json）：读现作者源 → 判重拦截（空 / 非 http(s) / 官方源 / 已在列表）→ 通过才落盘 marketplace.marketplaceSources；落盘后配置变更自动重拉目录。回执三态：加上了 {ok:true,added} ／ 没变化 {ok:true,noop:true,reason:official|duplicate} ／ 调用不成立 {ok:false,noop:true,reason:empty|bad-url}",
        "params": [
          {
            "name": "url",
            "type": "string",
            "required": true,
            "description": "作者仓库地址（仓库主页或 HEAD 直链均可，保持原样落盘——不归一；例：https://github.com/作者/仓库）"
          }
        ]
      },
      {
        "id": "marketplace.openStore",
        "risk": "R1",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when the tab was opened/focused"
          },
          {
            "name": "tabId",
            "type": "string",
            "description": "Host tab id (empty for fire-and-forget create)"
          }
        ],
        "example": {},
        "title": "打开插件市场",
        "category": "插件市场",
        "description": "打开（或聚焦）插件市场主标签页，并把导航目标复位到首页。回执 {ok, tabId}——store 命令经 openOrFocus，tabId 为壳回执的真实标签 id（超时/无事件时为空串）",
        "params": []
      },
      {
        "id": "marketplace.openRepoAll",
        "risk": "R1",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when the tab was opened/focused"
          },
          {
            "name": "tabId",
            "type": "string",
            "description": "Host tab id (empty for fire-and-forget create)"
          }
        ],
        "example": {},
        "title": "查看全部插件",
        "category": "插件市场",
        "description": "打开插件市场并导航到「全部插件」页——范围 = 当前仓库（currentRepo；19 §七），含仓库卡横排与全部插件网格。回执 {ok, tabId}",
        "params": []
      },
      {
        "id": "marketplace.openCategory",
        "risk": "R1",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when the tab was opened/focused"
          },
          {
            "name": "tabId",
            "type": "string",
            "description": "Host tab id (empty for fire-and-forget create)"
          }
        ],
        "example": {
          "category": "development"
        },
        "title": "打开分类",
        "category": "插件市场",
        "description": "打开插件市场并导航到某分类页（rail 分类 slug，如 development/hardware/themes）；可选 authorId/official 按页主范围预过滤（作者店/官方店的「更多」落页）。回执 {ok, tabId}",
        "params": [
          {
            "name": "category",
            "type": "string",
            "required": true,
            "description": "主分类 slug（04 §5.1 封闭名单；other = 其他桶）"
          },
          {
            "name": "authorId",
            "type": "string",
            "description": "可选：作者聚合键——只显示该作者在该分类下的插件（不传 = 全量分类页）"
          },
          {
            "name": "official",
            "type": "boolean",
            "description": "可选：true = 只显示官方源在该分类下的插件（官方店「更多」落页；与 authorId 互斥）"
          }
        ]
      },
      {
        "id": "marketplace.openRank",
        "risk": "R1",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when the tab was opened/focused"
          },
          {
            "name": "tabId",
            "type": "string",
            "description": "Host tab id (empty for fire-and-forget create)"
          }
        ],
        "example": {},
        "title": "打开排行榜",
        "category": "插件市场",
        "description": "打开插件市场并导航到「排行榜」（全源热门下载 Top 50）。回执 {ok, tabId}",
        "params": []
      },
      {
        "id": "marketplace.openAuthors",
        "risk": "R1",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when the tab was opened/focused"
          },
          {
            "name": "tabId",
            "type": "string",
            "description": "Host tab id (empty for fire-and-forget create)"
          }
        ],
        "example": {},
        "title": "打开作者页",
        "category": "插件市场",
        "description": "打开插件市场并导航到「作者」列表页（全部作者卡）。回执 {ok, tabId}",
        "params": []
      },
      {
        "id": "marketplace.openLibrary",
        "risk": "R1",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when the tab was opened/focused"
          },
          {
            "name": "tabId",
            "type": "string",
            "description": "Host tab id (empty for fire-and-forget create)"
          }
        ],
        "example": {},
        "title": "打开我的库",
        "category": "插件市场",
        "description": "打开插件市场并导航到「我的库」。回执 {ok, tabId}",
        "params": []
      },
      {
        "id": "marketplace.openAuthor",
        "risk": "R1",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when the tab was opened/focused"
          },
          {
            "name": "tabId",
            "type": "string",
            "description": "Host tab id (empty for fire-and-forget create)"
          }
        ],
        "example": {
          "authorId": "encaron"
        },
        "title": "打开作者主页",
        "category": "插件市场",
        "description": "打开插件市场并导航到作者主页；可选 repoId 直接定位该作者的某个仓库（同一作者多仓时用）。回执 {ok, tabId}",
        "params": [
          {
            "name": "authorId",
            "type": "string",
            "required": true,
            "description": "作者聚合键（目录条目 authorId / 来源仓库 owner）"
          },
          {
            "name": "repoId",
            "type": "string",
            "description": "可选：作者名下仓库 id（不传 = 作者店总览）"
          }
        ]
      },
      {
        "id": "marketplace.openPlugin",
        "risk": "R1",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when the tab was opened/focused"
          },
          {
            "name": "tabId",
            "type": "string",
            "description": "Host tab id (empty for fire-and-forget create)"
          }
        ],
        "example": {
          "pluginId": "serial-monitor"
        },
        "title": "打开插件详情",
        "category": "插件市场",
        "description": "在新标签页打开插件详情（默认 pinned:true，不参与预览替换；标签名取目录条目名，退化到已装 manifest 名 / pluginId）。回执 {ok, tabId}——create 是 fire 型通道，tabId 恒为空串",
        "params": [
          {
            "name": "pluginId",
            "type": "string",
            "required": true,
            "description": "插件 id（目录条目 id = pluginId）"
          },
          {
            "name": "pinned",
            "type": "boolean",
            "description": "是否钉住详情标签（缺省 true）"
          }
        ]
      },
      {
        "id": "marketplace.openSources",
        "risk": "R1",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when the tab was opened/focused"
          },
          {
            "name": "tabId",
            "type": "string",
            "description": "Host tab id (empty for fire-and-forget create)"
          }
        ],
        "example": {},
        "title": "管理来源",
        "category": "插件市场",
        "description": "打开插件市场并导航到作者页的「管理来源」模式（来源页已并入，19 §3.4；⛔ 独立来源页）。回执 {ok, tabId}",
        "params": []
      },
      {
        "id": "marketplace.search",
        "risk": "R1",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when the tab was opened/focused"
          },
          {
            "name": "tabId",
            "type": "string",
            "description": "Host tab id (empty for fire-and-forget create)"
          }
        ],
        "example": {
          "query": "serial"
        },
        "title": "搜索插件市场",
        "category": "插件市场",
        "description": "把市场搜索词设为 query（侧栏各组与商店搜索同源同步），并打开商店搜索页。回执 {ok, tabId}",
        "params": [
          {
            "name": "query",
            "type": "string",
            "required": true,
            "description": "搜索词（空串 = 清空搜索）"
          }
        ]
      },
      {
        "id": "marketplace.getState",
        "risk": "R0",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "Always true"
          },
          {
            "name": "route",
            "type": "object",
            "description": "Current actual route (authorId/repoId/query)"
          },
          {
            "name": "currentRepo",
            "type": "object",
            "description": "{authorId, repoId} of the browsing context"
          },
          {
            "name": "currentRepoName",
            "type": "string",
            "description": "Display name of the current repo"
          },
          {
            "name": "authorOrder",
            "type": "array",
            "description": "Author container order"
          },
          {
            "name": "repoOrder",
            "type": "object",
            "description": "Author → repo order map"
          },
          {
            "name": "visibleAuthors",
            "type": "array",
            "description": "Visible author ids"
          },
          {
            "name": "visibleRepos",
            "type": "array",
            "description": "Visible repos [{authorId,repoId}]"
          },
          {
            "name": "visibleEntryIds",
            "type": "array",
            "description": "Visible catalog entry ids on this route"
          },
          {
            "name": "visibleAuthorIds",
            "type": "array",
            "description": "Visible author ids on this page"
          },
          {
            "name": "navCommands",
            "type": "array",
            "description": "One navigation command per page"
          },
          {
            "name": "entries",
            "type": "array",
            "description": "Store catalog entries"
          },
          {
            "name": "collections",
            "type": "array",
            "description": "Store collections"
          },
          {
            "name": "authors",
            "type": "array",
            "description": "Author cards"
          },
          {
            "name": "sources",
            "type": "array",
            "description": "Marketplace sources"
          },
          {
            "name": "counts",
            "type": "object",
            "description": "Totals {entries,installed,updates,authors,remoteSources}"
          }
        ],
        "example": {},
        "title": "读取市场状态",
        "category": "插件市场",
        "description": "只读：返回当前实际路由（含 authorId/repoId/query）、每页导航命令、目录条目（价格/分类/作者/来源/本地状态/可执行能力）、合集、作者与其仓库/插件、来源列表与计数。AI 读取面唯一入口——⛔ 不靠截图/DOM。",
        "params": []
      },
      {
        "id": "marketplace.addLocalPlugin",
        "risk": "R3",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when installed"
          },
          {
            "name": "reason",
            "type": "string",
            "optional": true,
            "description": "empty | unavailable | io"
          }
        ],
        "example": {
          "path": "C:/demo/plugin.linkdesk-plugin"
        },
        "title": "添加本地插件",
        "category": "插件市场",
        "description": "从本地文件夹或 .linkdesk-plugin 离线包安装插件（复用壳 pluginManager.installFromDirectory：校验/复制到 userData/plugins/注册与网络安装同一流水线），成功后记入 pluginState localInstalls 供来源页溯源。回执 {ok, reason?}（reason: empty|unavailable|bad-manifest|unsafe-id|core-forbidden|exists|io）",
        "params": [
          {
            "name": "path",
            "type": "string",
            "required": true,
            "description": "含 plugin.json 的单插件文件夹路径，或 .linkdesk-plugin 包路径"
          }
        ]
      },
      {
        "id": "marketplace.removeSource",
        "risk": "R2",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when removed"
          },
          {
            "name": "reason",
            "type": "string",
            "optional": true,
            "description": "bad-url | official | not-found | io"
          }
        ],
        "example": {
          "url": "https://github.com/encaron/linkdesk-marketplace"
        },
        "title": "移除市场源",
        "category": "插件市场",
        "description": "从 marketplace.marketplaceSources 移除一个作者源（按 url/path 身份或数组 index）。保留其余记录的原始形态（不归一化重写）；官方源恒不在册（传官方 = 调用不成立）。回执 {ok, reason?}（reason: bad-arg|not-found|official）",
        "params": [
          {
            "name": "target",
            "type": "object",
            "description": "要移除的目标：{url:\"...\"} 或 {path:\"...\"}（身份匹配）或 {index:0}（数组下标）"
          }
        ]
      },
      {
        "id": "marketplace.checkUpdates",
        "risk": "R1",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when the check completed"
          },
          {
            "name": "count",
            "type": "number",
            "description": "Updatable plugins found"
          }
        ],
        "example": {},
        "title": "检查插件更新",
        "category": "插件市场",
        "description": "手动检查已装插件更新（唯一动作 = services/updateCheck：强拉目录 + 发现腿 + 目录重投影；只发现/记账/通知，不构成自动更新授权）。回执 {ok, count}（ok=false = 判不了：目录取不到/读盘不可信；count = 可更新插件数）",
        "params": []
      },
      {
        "id": "marketplace.refreshCatalog",
        "risk": "R1",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when refreshed"
          },
          {
            "name": "changed",
            "type": "boolean",
            "description": "Whether the catalog changed"
          }
        ],
        "example": {},
        "title": "刷新目录内容",
        "category": "插件市场",
        "description": "强刷目录内容（清 5min 缓存、重拉全部源并重投影；与「检查更新」是两个事实——本命令不跑插件版本发现）。回执 {ok, changed}（changed = 目录内容签名变化，同内容重拉为 false）",
        "params": []
      },
      {
        "id": "marketplace.markAllRead",
        "risk": "R1",
        "activation": "entry",
        "returns": [
          {
            "name": "cleared",
            "type": "number",
            "description": "Discover badges cleared"
          },
          {
            "name": "reason",
            "type": "string",
            "optional": true,
            "description": "bad-arg"
          }
        ],
        "example": {
          "kind": "all"
        },
        "title": "全部标为已读",
        "category": "插件市场",
        "description": "清掉发现型新内容点（分类项/作者项；⛔ 不碰任务型更新数字）——把当前目录里未读的键并入 pluginState discoverReads 并推进时间锚。回执 {cleared, reason?}（cleared = 本次实际清掉的点数）",
        "params": [
          {
            "name": "kind",
            "type": "string",
            "required": true,
            "description": "清理范围：category（仅分类点）| author（仅作者点）| all（两类都清并推进 until）"
          }
        ]
      },
      {
        "id": "marketplace.setViewPrefs",
        "risk": "R1",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when persisted"
          },
          {
            "name": "reason",
            "type": "string",
            "optional": true,
            "description": "bad-arg | io"
          }
        ],
        "example": {
          "page": "home",
          "view": "grid",
          "sort": "name"
        },
        "title": "设置视图偏好",
        "category": "插件市场",
        "description": "记住视图方式/排序（pluginState marketplace.ui.prefs，跨重启生效；幂等）。page=lib|author|cat；view=grid|list；sort 按页取值：lib=name|updated|size|source|author|repo，cat=dl|upd|az|author|repo，author=name|plugins|repos。⛔ 不进 contributes.configuration。回执 {ok, reason?}",
        "params": [
          {
            "name": "prefs",
            "type": "object",
            "required": true,
            "description": "{ page:\"lib\"|\"author\"|\"cat\", view?: \"grid\"|\"list\", sort?: string }"
          }
        ]
      },
      {
        "id": "marketplace.setSourcesDefaultCollapsed",
        "risk": "R1",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when persisted"
          },
          {
            "name": "collapsed",
            "type": "boolean",
            "optional": true,
            "description": "Value written"
          },
          {
            "name": "reason",
            "type": "string",
            "optional": true,
            "description": "bad-arg | unsupported | io"
          }
        ],
        "example": {
          "collapsed": true
        },
        "title": "设置来源分组默认收起",
        "category": "插件市场",
        "description": "设置「来源」页作者/官方分组打开时默认收起还是展开（true=默认收起）。落盘 marketplace.sourcesDefaultCollapsed；设置页同键可调。回执 {ok, collapsed} 或 {ok:false, reason}",
        "params": [
          {
            "name": "collapsed",
            "type": "boolean",
            "required": true,
            "description": "true = 默认收起；false = 默认展开"
          }
        ]
      },
      {
        "id": "marketplace.swapAuthors",
        "risk": "R1",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when the swap succeeded"
          },
          {
            "name": "authorOrder",
            "type": "array",
            "optional": true,
            "description": "Author container order"
          },
          {
            "name": "repoOrder",
            "type": "object",
            "optional": true,
            "description": "Author → repo order map"
          },
          {
            "name": "reason",
            "type": "string",
            "optional": true,
            "description": "bad-arg | not-swappable | io"
          }
        ],
        "example": {
          "authorIdA": "a",
          "authorIdB": "b"
        },
        "title": "交换作者顺序",
        "category": "插件市场",
        "description": "交换两个作者容器的顺序（唯一真相源 marketplace.marketplaceSources 数组序；GUI 长按拖动与命令调用同一份 swap 函数）。回执 {ok:true, authorOrder, repoOrder}；失败 {ok:false, reason: bad-arg|not-found|same}。本地插件组不参与作者排序",
        "params": [
          {
            "name": "authorIdA",
            "type": "string",
            "required": true,
            "description": "作者聚合键（目录条目 authorId；官方 = official）"
          },
          {
            "name": "authorIdB",
            "type": "string",
            "required": true,
            "description": "另一个作者聚合键（与 A 不同）"
          }
        ]
      },
      {
        "id": "marketplace.swapRepos",
        "risk": "R1",
        "activation": "entry",
        "returns": [
          {
            "name": "ok",
            "type": "boolean",
            "description": "True when the swap succeeded"
