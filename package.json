{
  "name": "linkdesk-plugin-marketplace",
  "version": "1.0.44",
  "private": true,
  "type": "module",
  "description": "插件市场（内置）——独立仓可自足构建：build 走 @linkdesk/plugin-sdk 的 npm 通道，依赖在 dependencies 里显式声明（不再靠壳仓 workspaces 提升），插件代码零 @src（消费 @linkdesk/ui 零件 + window.linkdesk.*）",
  "scripts": {
    "dev": "linkdesk-plugin-sdk dev",
    "dev:real": "linkdesk-plugin-sdk dev --real",
    "build": "linkdesk-plugin-sdk build",
    "validate": "linkdesk-plugin-sdk validate",
    "lint": "linkdesk-plugin-sdk lint",
    "publish": "linkdesk-plugin-sdk publish",
    "verify": "node scripts/ci-verify.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@linkdesk/contracts": "^0.1.15",
    "@linkdesk/ui": "^0.2.13"
  },
  "devDependencies": {
    "@linkdesk/plugin-sdk": "^0.1.46",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "jsdom": "^29.1.1",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
